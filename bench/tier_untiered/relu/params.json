{
  "kernel": "relu",
  "tier": "untiered",
  "forge_kernel": "elementwise/relu",
  "forge_recipe": "none yet; sizes as vecadd",
  "dtype": "int64",
  "seed": 0,
  "sizes": [{"n": 64}, {"n": 512}],
  "W": [1, 4, 8],
  "iface": "axis",
  "axis": ["A", "B"],
  "axis_register_mode": "off",
  "config": {"loop_count": "n // W"},
  "cflags": ["-std=c++14", "-DHLSLIB_SYNTHESIS", "-I{bench}/include", "-I{bench}/gen/dace_include"],
  "tb": "src/tb_relu.cpp",
  "cases": {
    "unopt": {"top": "relu", "src": ["src/relu.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "opt": {"top": "relu", "src": ["src/relu.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "dace": {
      "top": "relu_dace",
      "per_w": true,
      "W": [1],
      "src": ["dace/w{W}/relu_dace.cpp", "dace/w{W}/relu_0_0.cpp"],
      "cflags": ["-DDACE_SYNTHESIS", "-DDACE_XILINX", "-DDACE_XILINX_DEVICE_CODE"]
    }
  },
  "dace": {"vectorize": false, "passes": [], "expansions": {}, "symbols": {"N": "loop_count * W"}}
}
