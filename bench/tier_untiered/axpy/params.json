{
  "kernel": "axpy",
  "tier": "untiered",
  "forge_kernel": "blas/axpy",
  "forge_recipe": "none yet; sizes as vecadd",
  "dtype": "int64",
  "seed": 0,
  "sizes": [{"n": 64}, {"n": 512}],
  "W": [1, 4, 8],
  "iface": "axis",
  "axis": ["x", "y", "y_out"],
  "axis_register_mode": "off",
  "config": {"loop_count": "n // W"},
  "scalars": ["alpha"],
  "cflags": ["-std=c++14", "-DHLSLIB_SYNTHESIS", "-I{bench}/include", "-I{bench}/gen/dace_include"],
  "tb": "src/tb_axpy.cpp",
  "cases": {
    "unopt": {"top": "axpy", "src": ["src/axpy.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "opt": {"top": "axpy", "src": ["src/axpy.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "dace": {
      "top": "axpy_dace",
      "per_w": true,
      "W": [1],
      "src": ["dace/w{W}/axpy_dace.cpp", "dace/w{W}/axpy_0_0.cpp"],
      "cflags": ["-DDACE_SYNTHESIS", "-DDACE_XILINX", "-DDACE_XILINX_DEVICE_CODE"]
    }
  },
  "dace": {"vectorize": false, "passes": [], "expansions": {}, "symbols": {"N": "loop_count * W"}, "split_inout": {"y": "y_out"}}
}
