{
  "kernel": "rowsum",
  "tier": "untiered",
  "forge_kernel": "elementwise/rowsum",
  "forge_recipe": "recipes/rowsum_serial.json (M = 4, N = 16, W = 1), recipes/rowsum.json (M = 8, N = 64, W = 4)",
  "dtype": "int64",
  "seed": 0,
  "sizes": [{"m": 4, "n": 16}, {"m": 8, "n": 64}],
  "W": [1, 2, 4, 8, 16, 32],
  "iface": "axis",
  "axis": ["A", "y"],
  "axis_register_mode": "off",
  "valid": "n % W == 0",
  "config": {"loop_count": "m * n // W", "len": "n // W"},
  "cflags": ["-std=c++14", "-DHLSLIB_SYNTHESIS", "-DAP_INT_MAX_W=4096", "-I{bench}/include", "-I{bench}/gen/dace_include"],
  "tb": "src/tb_rowsum.cpp",
  "cases": {
    "unopt": {"top": "rowsum", "src": ["src/rowsum.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "opt": {"top": "rowsum", "src": ["src/rowsum.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "dace": {
      "top": "rowsum_dace",
      "per_w": true,
      "W": [1],
      "src": ["dace/w{W}/rowsum_dace.cpp", "dace/w{W}/rowsum_0_0.cpp"],
      "cflags": ["-DDACE_SYNTHESIS", "-DDACE_XILINX", "-DDACE_XILINX_DEVICE_CODE"]
    }
  },
  "dace": {"vectorize": false, "passes": [], "expansions": {}, "symbols": {"M": "loop_count / len", "N": "len * W"}, "buffer_outputs": {"y": "M"}}
}
