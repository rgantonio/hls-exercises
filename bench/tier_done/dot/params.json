{
  "kernel": "dot",
  "tier": "done",
  "forge_kernel": "polybench/dot",
  "forge_recipe": "recipes/dot.json (adder tree), recipes/dot_serial.json (accumulator); parked in forge until M13",
  "dtype": "int64",
  "seed": 0,
  "sizes": [{"n": 64}, {"n": 512}],
  "W": [1, 4, 8],
  "iface": "axis",
  "axis": ["A", "B", "out"],
  "axis_register_mode": "off",
  "config": {"loop_count": "n // W", "len": "n // W"},
  "cflags": ["-std=c++14", "-DHLSLIB_SYNTHESIS", "-I{bench}/include", "-I{bench}/gen/dace_include"],
  "tb": "src/tb_dot.cpp",
  "cases": {
    "unopt": {"top": "dot", "src": ["src/dot.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "opt": {"top": "dot", "src": ["src/dot.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "dace": {
      "top": "dot_dace",
      "per_w": true,
      "W": [1],
      "src": ["dace/w{W}/dot_dace.cpp", "dace/w{W}/dot_0_0.cpp"],
      "cflags": ["-DDACE_SYNTHESIS", "-DDACE_XILINX", "-DDACE_XILINX_DEVICE_CODE"]
    }
  },
  "dace": {"vectorize": false, "passes": [], "expansions": {}, "symbols": {"N": "loop_count * W"}}
}
