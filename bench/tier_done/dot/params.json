{
  "kernel": "dot",
  "tier": "done",
  "forge_kernel": "polybench/dot",
  "forge_recipe": "recipes/dot.json (adder tree), recipes/dot_serial.json (accumulator); parked in forge until M13",
  "dtype": "int64",
  "seed": 0,
  "sizes": [{"n": 64}, {"n": 512}],
  "W": [1, 4, 8],
  "iface": "axis",
  "axis": ["A", "B", "out"],
  "cflags": ["-std=c++14", "-I{bench}/include", "-I{bench}/gen/dace_include"],
  "tb": "src/tb_dot.cpp",
  "cases": {
    "unopt": {"top": "dot", "src": ["src/dot.cpp"], "per_w": true},
    "opt": {"top": "dot", "src": ["src/dot.cpp"], "per_w": true},
    "dace": {
      "top": "dot_dace",
      "per_w": true,
      "W": [1],
      "src": ["dace/{size}_w{W}/dot_dace.cpp", "dace/{size}_w{W}/dot_0_0.cpp"],
      "cflags": ["-DDACE_SYNTHESIS", "-DDACE_XILINX", "-DDACE_XILINX_DEVICE_CODE", "-DHLSLIB_SYNTHESIS"]
    }
  },
  "dace": {"vectorize": false, "passes": [], "expansions": {}}
}
