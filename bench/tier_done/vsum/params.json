{
  "kernel": "vsum",
  "tier": "done",
  "forge_kernel": "polybench/vsum",
  "forge_recipe": "recipes/vsum.json (W = 1, accumulator), recipes/vsum_tree.json (W = 4, adder tree)",
  "dtype": "int64",
  "seed": 0,
  "sizes": [{"n": 64}, {"n": 512}],
  "W": [1, 2, 4, 8, 16, 32],
  "iface": "axis",
  "axis": ["A", "out"],
  "axis_register_mode": "off",
  "config": {"loop_count": "n // W", "len": "n // W"},
  "cflags": ["-std=c++14", "-DHLSLIB_SYNTHESIS", "-DAP_INT_MAX_W=4096", "-I{bench}/include", "-I{bench}/gen/dace_include"],
  "tb": "src/tb_vsum.cpp",
  "cases": {
    "unopt": {"top": "vsum", "src": ["src/vsum.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "opt": {"top": "vsum", "src": ["src/vsum.cpp"], "per_w": true, "tripcount": {"BEAT": "loop_count"}},
    "dace": {
      "top": "vsum_dace",
      "per_w": true,
      "W": [1],
      "src": ["dace/w{W}/vsum_dace.cpp", "dace/w{W}/vsum_0_0.cpp"],
      "cflags": ["-DDACE_SYNTHESIS", "-DDACE_XILINX", "-DDACE_XILINX_DEVICE_CODE"]
    },
    "bambu_unopt": {"tool": "bambu", "top": "vsum", "src": ["src/vsum.cpp"], "per_w": true},
    "bambu_opt": {"tool": "bambu", "top": "vsum", "src": ["src/vsum.cpp"], "per_w": true}
  },
  "dace": {"vectorize": false, "passes": [], "expansions": {}, "symbols": {"N": "loop_count * W"}},
  "bambu": {"param_size": {"A": "n * 8", "out": "NOUT * 8"}, "pragmas": {"bambu_opt": {"LANE": "unroll"}}}
}
